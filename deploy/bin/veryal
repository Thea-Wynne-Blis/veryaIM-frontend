#!/usr/bin/env bash
# ============================================================
# VERYAL 运维脚本合集：start / stop / restart / status / logs
#   安装位置: /home/ubuntu/veryal/bin/veryal
#   用法:     veryal <命令>
# ============================================================
set -uo pipefail

APP_HOME=/home/ubuntu/veryal
LOG="$APP_HOME/logs/backend.log"
PORT=8899
APP_PORT=8080
UNIT=veryal-backend

c_ok()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
c_inf() { printf '\033[1;36m%s\033[0m\n' "$*"; }
c_err() { printf '\033[1;31m%s\033[0m\n' "$*"; }

health() {
  curl -fsS -m 3 "http://127.0.0.1:${APP_PORT}/actuator/health" 2>/dev/null
}

cmd_start() {
  c_inf "启动后端…"
  sudo systemctl start "$UNIT"
  for i in $(seq 1 60); do
    if health >/dev/null; then c_ok "后端已就绪"; break; fi
    [ "$i" -eq 60 ] && c_err "启动超时，查看日志: veryal logs"
    sleep 2
  done
  c_inf "确保 nginx 运行…"
  sudo systemctl start nginx
  c_ok "全部已启动 → http://<服务器IP>:${PORT}/"
}

cmd_stop() {
  c_inf "停止后端…"
  sudo systemctl stop "$UNIT"
  c_ok "后端已停止（nginx 仍在运行，页面会提示服务不可用）"
}

cmd_restart() {
  sudo systemctl restart "$UNIT"
  for i in $(seq 1 60); do
    if health >/dev/null; then c_ok "后端已重启并就绪"; return; fi
    sleep 2
  done
  c_err "重启后健康检查未通过"
}

cmd_status() {
  echo "──────── 服务状态 ────────"
  printf '%-14s %s\n' "backend" "$(systemctl is-active $UNIT 2>/dev/null)"
  printf '%-14s %s\n' "nginx" "$(systemctl is-active nginx 2>/dev/null)"
  printf '%-14s %s\n' "docker mysql" "$(docker inspect -f '{{.State.Status}}' veryal-mysql 2>/dev/null)"
  printf '%-14s %s\n' "docker redis" "$(docker inspect -f '{{.State.Status}}' veryal-redis 2>/dev/null)"
  printf '%-14s %s\n' "docker rabbitmq" "$(docker inspect -f '{{.State.Status}}' veryal-rabbitmq 2>/dev/null)"
  echo
  echo "──────── 健康检查 ────────"
  h=$(health) && echo "backend  $h" || echo "backend  不可达"
  echo
  echo "──────── 端口监听 ────────"
  ss -lntp 2>/dev/null | grep -E ":(${PORT}|${APP_PORT})\b" || echo "未监听"
  echo
  echo "──────── 资源 ────────"
  ps -o pid,rss,etime,cmd -C java --no-headers 2>/dev/null | awk '{printf "PID %s  内存 %.0fMB  运行 %s\n", $1, $2/1024, $3}'
  echo
  echo "──────── 入口 ────────"
  printf '页面  HTTP %s\n' "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:${PORT}/ || echo 000)"
  printf 'API   HTTP %s\n' "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:${PORT}/api/v1/auth/login || echo 000)"
}

cmd_logs() {
  local which="${2:-info}"
  local lines="${3:-120}"
  local file
  case "$which" in
    error|err) file="$APP_HOME/logs/error.log" ;;
    warn)      file="$APP_HOME/logs/warn.log" ;;
    stdout|out) file="$APP_HOME/logs/stdout.log" ;;
    info|*)    file="$APP_HOME/logs/info.log" ;;
  esac
  if [ ! -f "$file" ]; then
    c_err "日志文件不存在: $file"
    echo "可用: $(ls -1 "$APP_HOME/logs" 2>/dev/null | tr '\n' ' ')"
    return 1
  fi
  c_inf "跟踪 $file"
  tail -n "$lines" -f "$file"
}

cmd_logs_ls() {
  echo "──────── 日志文件 ────────"
  if [ -d "$APP_HOME/logs" ]; then
    find "$APP_HOME/logs" -maxdepth 1 -type f -name '*.log' -printf '%-24f %8s\n' 2>/dev/null \
      || ls -lh "$APP_HOME/logs"/*.log
    echo
    echo "归档: $(find "$APP_HOME/logs/archive" -type f 2>/dev/null | wc -l) 个"
    echo "总占用: $(du -sh "$APP_HOME/logs" 2>/dev/null | cut -f1)"
  else
    c_err "日志目录不存在"
  fi
}

case "${1:-status}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs "$@" ;;
  logls)   cmd_logs_ls ;;
  *)
    cat <<EOF
VERYAL 控制台

  veryal start            启动后端 + nginx
  veryal stop             停止后端
  veryal restart          重启后端
  veryal status           查看状态（默认）
  veryal logs [类型] [行数]
                          跟踪日志，类型默认 info
                          info | warn | error | stdout
  veryal logls            列出日志文件与占用

  示例:
    veryal logs            跟踪 info.log
    veryal logs error 300  看最近 300 行错误
EOF
    ;;
esac
