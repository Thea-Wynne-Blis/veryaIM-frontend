# ============================================================
# VERYAL 后端运行时配置（复制成 .env 后再改，.env 不会被提交）
#
#   cp config/.env.example config/.env
#   chmod 600 config/.env
#
# 启动脚本 config/start.sh 会扫描本文件（或仓库根目录的 .env），
# 用它渲染出 config/application-local.yaml，再带着 local profile 启动。
# ============================================================

# ---------- 数据库 ----------
VERYAL_DB_URL="jdbc:mysql://127.0.0.1:3306/veryal_im?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&rewriteBatchedStatements=true"
VERYAL_DB_USER=veryal
VERYAL_DB_PASSWORD=change-me

# ---------- 令牌签名 ----------
# 至少 32 个字符，换掉会让已登录用户掉线。
VERYAL_TOKEN_SECRET=change-me-to-a-long-random-string

# ---------- Redis（在线状态 / 限流 / 缓存）----------
VERYAL_REDIS_ENABLED=true
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
# VERYAL_REDIS_PASSWORD=

# ---------- RabbitMQ（多实例实时分发，单机可关）----------
VERYAL_MQ_ENABLED=false
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=veryal
SPRING_RABBITMQ_PASSWORD=change-me
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# ---------- 文件存储 ----------
VERYAL_STORAGE_TYPE=local
VERYAL_STORAGE_LOCAL_ROOT=./data/files
VERYAL_UPLOAD_STAGING=./data/uploads

# ---------- 日志 ----------
VERYAL_LOG_PATH=./logs

# ---------- 集群 / 实时推送 ----------
VERYAL_NODE_ID=1
VERYAL_REALTIME_FANOUT_THREADS=2

# ---------- 运营后台 ----------
VERYAL_PLATFORM_BOOTSTRAP_USERNAME=
VERYAL_PLATFORM_BOOTSTRAP_PASSWORD=
VERYAL_PLATFORM_TOKEN_SECRET=

# ---------- Web Push（可选）----------
VERYAL_PUSH_WEB_PUSH_ENABLED=false
VERYAL_PUSH_WEB_PUSH_KEY_FILE=./data/vapid-keys.json

# ---------- 翻译（可选，百度翻译开放平台）----------
VERYAL_TRANSLATE_APP_ID=
VERYAL_TRANSLATE_SECRET=
