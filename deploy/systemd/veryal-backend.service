[Unit]
Description=VERYAL Backend (Spring Boot)
Documentation=https://github.com/Thea-Wynne-Blis/veryaIM
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/veryal

# 启动脚本负责：用 config/.env 渲染 config/application-local.yaml，
# 再把 .env 导出成环境变量，带 prod,local 两个 profile 启动 jar。
ExecStart=/home/ubuntu/veryal/config/start.sh

Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=40
KillSignal=SIGTERM

StandardOutput=append:/home/ubuntu/veryal/logs/stdout.log
StandardError=append:/home/ubuntu/veryal/logs/stdout.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
