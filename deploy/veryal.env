# VERYAL 后端运行时环境（systemd EnvironmentFile）
# 部署根目录：/home/ubuntu/veryal

# ---------- 数据库（Docker veryal-mysql，127.0.0.1:13306）----------
VERYAL_DB_URL=jdbc:mysql://127.0.0.1:13306/veryal_im?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
VERYAL_DB_USER=veryal
VERYAL_DB_PASSWORD=veryal123

# ---------- JWT ----------
VERYAL_TOKEN_SECRET=veryal-prod-token-secret-7f3c9a1e5b8d2046

# ---------- Redis（Docker veryal-redis，127.0.0.1:16379）----------
VERYAL_REDIS_ENABLED=true
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=16379

# ---------- RabbitMQ（Docker veryal-rabbitmq，127.0.0.1:5672）----------
# 单节点关闭 MQ，走 Outbox 本机直投
VERYAL_MQ_ENABLED=false
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=veryal
SPRING_RABBITMQ_PASSWORD=veryal
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# ---------- 存储 ----------
VERYAL_STORAGE_TYPE=local
VERYAL_STORAGE_LOCAL_ROOT=/home/ubuntu/veryal/data/files
VERYAL_UPLOAD_STAGING=/home/ubuntu/veryal/data/uploads

# ---------- Web Push ----------
VERYAL_PUSH_WEB_PUSH_ENABLED=false
VERYAL_PUSH_WEB_PUSH_KEY_FILE=/home/ubuntu/veryal/data/vapid-keys.json

# ---------- 运营后台初始账号 ----------
VERYAL_PLATFORM_BOOTSTRAP_USERNAME=platform_admin
VERYAL_PLATFORM_BOOTSTRAP_PASSWORD=Veryal@2026
VERYAL_PLATFORM_TOKEN_SECRET=veryal-prod-platform-secret-3a8f2b6c9d1e4057

# ---------- 日志 ----------#
# 由 logback-spring.xml 读取，输出 info.log / warn.log / error.log
VERYAL_LOG_PATH=/home/ubuntu/veryal/logs

# ---------- 节点 ----------
VERYAL_NODE_ID=1
